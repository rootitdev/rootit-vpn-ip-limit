#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import os
import sys

sys.path.insert(0, "/opt/vpn-ip-limit")
import core as C


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "help"
    cfg = C.load_cfg()
    state = C.load_state()
    tg = cfg.get("telegram") or {}

    if arg in ("status", "s"):
        key = C.get_key()
        print(C.status_report(cfg, key))
        return 0
    if arg == "off":
        cfg["enabled"] = False
        C.save_cfg(cfg)
        C.service_disable()
        print("Guard OFF")
        return 0
    if arg == "run":
        key = C.get_key()
        actions = C.run_once(cfg, state, key)
        C.save_state(state)
        print("\n".join(actions) if actions else "no actions")
        return 0
    if arg == "password":
        print(tg.get("access_password") or "")
        return 0
    if arg == "setup":
        return os.system("/usr/local/bin/vpn-ip-limit-setup") >> 8
    if arg == "log":
        print(C.tail_log(cfg, int(sys.argv[2]) if len(sys.argv) > 2 else 50))
        return 0
    if arg in ("bot-log", "blog"):
        print(C.tail_file(C.BOT_LOG_PATH, int(sys.argv[2]) if len(sys.argv) > 2 else 80))
        return 0
    if arg in ("diag", "diagnostics"):
        key = C.get_key()
        print(C.diagnostics_report(cfg, key))
        print("\nSaved: /tmp/vpn-ip-limit-diag.txt")
        return 0
    if arg == "update":
        # Re-run installer from current git checkout if present
        candidates = [
            "/root/rootit-vpn-ip-limit",
            "/opt/src/rootit-vpn-ip-limit",
            os.getcwd(),
        ]
        for d in candidates:
            inst = os.path.join(d, "install.sh")
            if os.path.isfile(inst):
                print(f"Updating from {d}")
                if os.path.isdir(os.path.join(d, ".git")):
                    os.system(f"git -C {d} pull --ff-only")
                rc = os.system(f"bash {inst}")
                os.system("systemctl restart vpn-ip-limit-bot.service")
                print("Bot restarted. Guard state unchanged.")
                return rc >> 8
        print("Install folder not found. Clone repo then:")
        print("  cd rootit-vpn-ip-limit && sudo bash install.sh")
        print("  sudo systemctl restart vpn-ip-limit-bot")
        return 1

    print(f"{C.TITLE} v{C.VERSION}")
    print(f"Support : {tg.get('support') or C.SUPPORT}")
    print(f"Bot     : @{tg.get('bot_username') or '-'}")
    print(f"Bot ID  : {tg.get('bot_id') or '-'}")
    print(f"Admins  : {tg.get('admin_ids') or []}")
    print(f"Password: {tg.get('access_password') or '-'}")
    print()
    print("Setup / sync Telegram bot:")
    print("  vpn-ip-limit setup")
    print()
    print("Other:")
    print("  vpn-ip-limit status")
    print("  vpn-ip-limit diag          # گزارش عیب‌یابی")
    print("  vpn-ip-limit log")
    print("  vpn-ip-limit bot-log")
    print("  vpn-ip-limit update        # آپدیت از پوشه git")
    print("  vpn-ip-limit off")
    print("  vpn-ip-limit password")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
